{
  "name": "openapi-typesafe",
  "description": "Convert OpenAPI 3.0, 3.1 & 3.2 schemas to TypeScript",
  "version": "1.0.0-rc.3",
  "author": {
    "name": "Fedor Chishchin",
    "url": "https://github.com/fedorello"
  },
  "contributors": [
    {
      "name": "Drew Powers",
      "email": "drew@pow.rs"
    }
  ],
  "license": "MIT",
  "bin": {
    "openapi-typesafe": "bin/cli.js"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./*.js": "./*.mjs",
    "./*": "./*"
  },
  "files": [
    "CHANGELOG.md",
    "bin",
    "dist",
    "src"
  ],
  "homepage": "https://github.com/openapi-typesafe/openapi-typesafe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openapi-typesafe/openapi-typesafe.git",
    "directory": "packages/openapi-typesafe"
  },
  "keywords": [
    "swagger",
    "typescript",
    "ts",
    "dts",
    "openapi",
    "codegen",
    "generation",
    "openapi 3",
    "node"
  ],
  "bugs": {
    "url": "https://github.com/openapi-typesafe/openapi-typesafe/issues"
  },
  "scripts": {
    "build": "unbuild",
    "dev": "tsc -p tsconfig.build.json --watch",
    "download:schemas": "vite-node ./scripts/download-schemas.ts",
    "format": "biome format . --write",
    "lint": "pnpm run lint:js && pnpm run lint:ts && pnpm run lint:deps && pnpm run lint:sizes",
    "lint:js": "biome check .",
    "lint:ts": "tsc --noEmit && tsc -p tsconfig.strict.json",
    "prepack": "pnpm run build",
    "test": "pnpm run test:js && pnpm run test:examples && pnpm run test:exports",
    "test:js": "vitest run",
    "test:exports": "pnpm run build && ../../scripts/check-exports.sh",
    "test:examples": "tsc -p tsconfig.examples.json --noEmit",
    "update:examples": "pnpm run build && pnpm run download:schemas && vite-node ./scripts/update-examples.ts",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "test:coverage": "vitest run --coverage",
    "lint:sizes": "vite-node scripts/size-rules/check-sizes.ts src"
  },
  "peerDependencies": {
    "@typescript/typescript6": "^6.0.0",
    "typescript": ">=5.4.0"
  },
  "peerDependenciesMeta": {
    "@typescript/typescript6": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@redocly/openapi-core": "^1.34.22",
    "ansi-colors": "^4.1.3",
    "change-case": "^5.4.4",
    "parse-json": "^8.3.0",
    "scule": "^1.3.0",
    "supports-color": "^11.0.0",
    "yargs-parser": "^22.0.0"
  },
  "devDependencies": {
    "@types/yargs-parser": "21.0.3",
    "@typescript/typescript6": "6.0.2",
    "degit": "3.10.1",
    "dependency-cruiser": "18.7.2",
    "execa": "catalog:",
    "fast-check": "4.10.2",
    "strip-ansi": "7.2.0",
    "typescript": "catalog:",
    "typescript-5.4": "npm:typescript@5.4.5",
    "typescript-7.0": "npm:typescript@7.0.2",
    "vite-node": "6.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
