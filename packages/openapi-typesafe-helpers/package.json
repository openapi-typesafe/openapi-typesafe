{
  "name": "openapi-typesafe-helpers",
  "description": "TypeScript helpers for consuming openapi-typesafe types",
  "version": "1.0.0-rc.3",
  "author": {
    "name": "Fedor Chishchin",
    "url": "https://github.com/fedorello"
  },
  "contributors": [
    {
      "name": "Drew Powers",
      "email": "drew@pow.rs"
    }
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./*": "./*"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "homepage": "https://github.com/openapi-typesafe/openapi-typesafe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openapi-typesafe/openapi-typesafe.git",
    "directory": "packages/openapi-typesafe-helpers"
  },
  "bugs": {
    "url": "https://github.com/openapi-typesafe/openapi-typesafe/issues"
  },
  "scripts": {
    "build": "unbuild",
    "format": "biome format src --write",
    "lint": "pnpm run lint:js && pnpm run lint:ts && pnpm run lint:sizes",
    "lint:js": "biome check src",
    "lint:ts": "tsc --noEmit",
    "lint:sizes": "vite-node ../openapi-typesafe/scripts/size-rules/check-sizes.ts src",
    "test": "pnpm run test:exports",
    "test:exports": "pnpm run build && ../../scripts/check-exports.sh"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-node": "6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
