{
  "name": "openapi-typesafe-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "author": {
    "name": "Fedor Chishchin",
    "email": "fedorstartup@gmail.com"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev": "pnpm run -r --parallel --filter \"{packages/*}\" --aggregate-output dev",
    "format": "turbo run format",
    "test": "turbo run test",
    "test-e2e": "turbo run test-e2e",
    "size": "turbo run size-limit",
    "version": "pnpm run build && changeset version && pnpm i",
    "verify": "scripts/verify.sh"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.4",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@playwright/test": "1.64.1",
    "@size-limit/preset-small-lib": "12.1.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.11",
    "prettier": "3.9.10",
    "size-limit": "12.1.0",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "unbuild": "3.6.1",
    "vitest": "4.1.11"
  },
  "size-limit": [
    {
      "path": "packages/openapi-typesafe-fetch/dist/index.mjs",
      "limit": "7.5 kB",
      "brotli": false
    }
  ]
}
