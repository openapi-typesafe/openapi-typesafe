{
  "name": "@openapi-typesafe/skill-evals",
  "version": "0.0.0",
  "private": true,
  "description": "Evaluates the openapi-typesafe agent skill: coding tasks checked by tsc and hidden tests",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "eval": "node src/cli/main.ts eval",
    "validate": "node src/cli/main.ts validate",
    "lint": "pnpm run lint:js && pnpm run lint:ts",
    "lint:js": "biome check .",
    "lint:ts": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.100.9",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "openapi-typesafe": "workspace:*",
    "openapi-typesafe-fetch": "workspace:*",
    "openapi-typesafe-helpers": "workspace:*",
    "openapi-typesafe-migrate": "workspace:*",
    "openapi-typesafe-react-query": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "catalog:",
    "vitest": "5.0.5"
  }
}
