{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": "//",
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "!**/examples",
      "!test/**/schemas",
      "!test/bench/**/*.min.js",
      "!**/dist",
      "!**/coverage"
    ]
  },
  "linter": {
    "rules": {
      "complexity": {
        "noBannedTypes": "off"
      },
      "suspicious": {
        "noConfusingVoidType": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "test/**"],
      "formatter": {
        "lineWidth": 100
      }
    },
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 30
              }
            },
            "useMaxParams": {
              "level": "error",
              "options": {
                "max": 4
              }
            }
          }
        }
      }
    }
  ]
}
