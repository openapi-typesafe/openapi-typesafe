{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": "//",
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "!**/examples",
      "!test/**/schemas",
      "!test/bench/**/*.min.js",
      "!**/dist",
      "!**/coverage"
    ]
  },
  "linter": {
    "rules": {
      "complexity": {
        "noBannedTypes": "off"
      },
      "suspicious": {
        "noConfusingVoidType": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "test/**"],
      "formatter": {
        "lineWidth": 100
      }
    }
  ]
}
