{
  "extends": "../../tsconfig.strict.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "target": "ES2022",
    "types": ["vitest/globals"],
    "exactOptionalPropertyTypes": false
  },
  "include": ["src", "test", "*.ts"],
  "exclude": ["node_modules", "test/registered-error"]
}
