{
  "name": "openapi-typesafe",
  "description": "Convert OpenAPI 3.0 & 3.1 schemas to TypeScript",
  "version": "0.0.0",
  "author": {
    "name": "Fedor Chishchin",
    "email": "fedorstartup@gmail.com"
  },
  "contributors": [
    {
      "name": "Drew Powers",
      "email": "drew@pow.rs"
    }
  ],
  "license": "MIT",
  "bin": {
    "openapi-typesafe": "bin/cli.js"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./*.js": "./*.mjs",
    "./*": "./*"
  },
  "homepage": "https://github.com/openapi-typesafe/openapi-typesafe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openapi-typesafe/openapi-typesafe.git",
    "directory": "packages/openapi-typesafe"
  },
  "keywords": [
    "swagger",
    "typescript",
    "ts",
    "dts",
    "openapi",
    "codegen",
    "generation",
    "openapi 3",
    "node"
  ],
  "bugs": {
    "url": "https://github.com/openapi-typesafe/openapi-typesafe/issues"
  },
  "scripts": {
    "build": "unbuild",
    "dev": "tsc -p tsconfig.build.json --watch",
    "download:schemas": "vite-node ./scripts/download-schemas.ts",
    "format": "biome format . --write",
    "lint": "pnpm run lint:js && pnpm run lint:ts && pnpm run lint:deps",
    "lint:js": "biome check .",
    "lint:ts": "tsc --noEmit",
    "prepack": "pnpm run build",
    "test": "pnpm run test:js && pnpm run test:examples && pnpm run test:exports",
    "test:js": "vitest run",
    "test:exports": "pnpm run build && attw --pack .",
    "test:examples": "tsc -p tsconfig.examples.json --noEmit",
    "update:examples": "pnpm run build && pnpm run download:schemas && vite-node ./scripts/update-examples.ts",
    "prepublish": "pnpm run build",
    "version": "pnpm run build",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs"
  },
  "peerDependencies": {
    "typescript": "^5.x"
  },
  "dependencies": {
    "@redocly/openapi-core": "^1.34.6",
    "ansi-colors": "^4.1.3",
    "change-case": "^5.4.4",
    "parse-json": "^8.3.0",
    "scule": "^1.3.0",
    "supports-color": "^11.0.0",
    "yargs-parser": "^22.0.0"
  },
  "devDependencies": {
    "@types/degit": "2.8.6",
    "@types/js-yaml": "4.0.9",
    "degit": "2.8.6",
    "dependency-cruiser": "18.7.0",
    "execa": "catalog:",
    "strip-ansi": "7.2.0",
    "typescript": "catalog:",
    "vite-node": "6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
