{
  "name": "openapi-typesafe-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build-docs": "vitepress build",
    "build-link-check-site": "DOCS_SITE_URL=http://localhost/ vitepress build --outDir .vitepress/dist-check",
    "check-links": "pnpm run build-link-check-site && node scripts/check-repository-links.mjs .vitepress/dist-check && linkinator .vitepress/dist-check --config linkinator.config.json",
    "check-external-links": "pnpm run build-link-check-site && linkinator .vitepress/dist-check --config linkinator.external.config.json",
    "dev": "vitepress dev"
  },
  "devDependencies": {
    "linkinator": "8.1.0",
    "vite": "catalog:",
    "vitepress": "1.6.4",
    "vitepress-plugin-llms": "1.14.0"
  }
}
