{
  "extends": "../../tsconfig.strict.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": false,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": ["src", "test", "*.ts"]
}
