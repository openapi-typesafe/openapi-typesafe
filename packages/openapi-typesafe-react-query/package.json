{
  "name": "openapi-typesafe-react-query",
  "description": "Fast, type-safe @tanstack/react-query client to work with your OpenAPI schema.",
  "version": "1.0.0-rc.5",
  "author": {
    "name": "Fedor Chishchin",
    "url": "https://github.com/fedorello"
  },
  "contributors": [
    {
      "name": "Martin Paucot",
      "email": "contact@martin-paucot.fr"
    }
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./*": "./*"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "src"
  ],
  "homepage": "https://github.com/openapi-typesafe/openapi-typesafe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openapi-typesafe/openapi-typesafe.git",
    "directory": "packages/openapi-typesafe-react-query"
  },
  "bugs": {
    "url": "https://github.com/openapi-typesafe/openapi-typesafe/issues"
  },
  "keywords": [
    "openapi",
    "swagger",
    "rest",
    "api",
    "oapi_3",
    "oapi_3_1",
    "typescript",
    "fetch",
    "react",
    "react-query",
    "tanstack"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "biome format . --write",
    "lint": "pnpm run lint:js && pnpm run lint:ts && pnpm run lint:sizes",
    "lint:js": "biome check .",
    "lint:ts": "tsc --noEmit",
    "lint:sizes": "vite-node ../openapi-typesafe/scripts/size-rules/check-sizes.ts src",
    "generate-types": "openapi-typesafe test/fixtures/api.yaml -o test/fixtures/api.d.ts && openapi-typesafe test/fixtures/query.yaml -o test/fixtures/query.d.ts",
    "prepack": "pnpm run build",
    "test": "pnpm run generate-types && pnpm run test:js && pnpm run test:exports",
    "test:js": "vitest run",
    "test:exports": "../../scripts/check-exports.sh",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.106.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "msw": "3.0.3",
    "openapi-typesafe": "workspace:^",
    "openapi-typesafe-fetch": "workspace:^",
    "openapi-typesafe-helpers": "workspace:^",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "vite-node": "6.0.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.80.0",
    "openapi-typesafe-fetch": "workspace:^"
  },
  "engines": {
    "node": ">=22"
  }
}
