{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "lint": {
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.css", "**/biome.json"],
      "dependsOn": ["build"]
    },
    "//#lint:changesets": {
      "inputs": [
        ".changeset/**/*.md",
        "scripts/check-changeset-texts.mjs",
        "scripts/changeset-texts.mjs",
        "scripts/changeset-texts.test.mjs"
      ]
    },
    "size-limit": {
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test-e2e": {
      "dependsOn": ["build"]
    }
  }
}
