{
  "name": "openapi-typesafe-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "author": {
    "name": "Fedor Chishchin",
    "url": "https://github.com/fedorello"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint //#lint:changesets --continue",
    "lint:changesets": "node --test scripts/changeset-texts.test.mjs && node scripts/check-changeset-texts.mjs",
    "dev": "pnpm run -r --parallel --filter \"{packages/*}\" --aggregate-output dev",
    "format": "turbo run format",
    "test": "turbo run test --continue",
    "test-e2e": "turbo run test-e2e",
    "size": "turbo run size-limit",
    "version-packages": "changeset version && biome format --write packages/*/CHANGELOG.md",
    "verify": "scripts/verify.sh",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@size-limit/preset-small-lib": "14.3.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "size-limit": "14.3.0",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "unbuild": "3.6.1",
    "vitest": "5.1.0"
  },
  "size-limit": [
    {
      "path": "packages/openapi-typesafe-fetch/dist/index.mjs",
      "limit": "11.3 kB",
      "brotli": false
    },
    {
      "path": "packages/openapi-typesafe-react-query/dist/index.mjs",
      "ignore": ["@tanstack/react-query", "openapi-typesafe-fetch", "react"],
      "limit": "3.9 kB",
      "brotli": false
    }
  ]
}
