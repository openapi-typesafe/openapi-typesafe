{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": "//",
  "files": {
    "includes": [
      "bin/**",
      "!examples",
      "src/**",
      "test/**",
      "scripts/bench-printer/**",
      "!**/fixtures/**/*",
      "!test/print-parity/original",
      "!**/dist",
      "!**/coverage"
    ]
  },
  "overrides": [
    {
      "includes": [
        "test/domain/**",
        "test/application/**",
        "test/adapters/**",
        "test/print-parity/**",
        "test/fakes/**",
        "test/lib/transform-context.test.ts",
        "scripts/bench-printer/**",
        "src/**",
        "scripts/size-rules/**"
      ],
      "formatter": {
        "lineWidth": 100
      }
    },
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 30
              }
            },
            "useMaxParams": {
              "level": "error",
              "options": {
                "max": 4
              }
            }
          },
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 300
              }
            }
          }
        }
      }
    }
  ]
}
