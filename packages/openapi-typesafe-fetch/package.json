{
  "name": "openapi-typesafe-fetch",
  "description": "Fast, type-safe fetch client for your OpenAPI schema. About 8.7 kB minified, 3.4 kB gzipped. Works with React, Vue, Svelte, or vanilla JS.",
  "version": "1.0.0-rc.2",
  "author": {
    "name": "Fedor Chishchin",
    "url": "https://github.com/fedorello"
  },
  "contributors": [
    {
      "name": "Drew Powers",
      "email": "drew@pow.rs"
    }
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./*": "./*"
  },
  "files": [
    "dist",
    "src"
  ],
  "homepage": "https://github.com/openapi-typesafe/openapi-typesafe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openapi-typesafe/openapi-typesafe.git",
    "directory": "packages/openapi-typesafe-fetch"
  },
  "bugs": {
    "url": "https://github.com/openapi-typesafe/openapi-typesafe/issues"
  },
  "keywords": [
    "openapi",
    "swagger",
    "rest",
    "api",
    "oapi_3",
    "oapi_3_1",
    "typescript",
    "fetch",
    "react",
    "vue",
    "svelte"
  ],
  "scripts": {
    "build": "unbuild",
    "format": "biome format . --write",
    "lint": "pnpm run lint:js && pnpm run lint:ts && pnpm run lint:ts-no-strict && pnpm run lint:sizes",
    "lint:js": "biome check .",
    "lint:ts": "tsc --noEmit",
    "lint:ts-no-strict": "tsc --noEmit -p test/no-strict-null-checks/tsconfig.json",
    "lint:sizes": "vite-node ../openapi-typesafe/scripts/size-rules/check-sizes.ts src",
    "generate-types": "openapi-typesafe -c test/redocly.yaml",
    "prepack": "pnpm run build",
    "pretest": "pnpm run generate-types",
    "test": "pnpm run test:js && pnpm run test:exports",
    "test:js": "vitest run",
    "test:exports": "pnpm run build && ../../scripts/check-exports.sh",
    "test-e2e": "playwright test",
    "bench:js": "vitest bench",
    "e2e-vite-build": "vite build test/e2e/app",
    "e2e-vite-start": "vite preview test/e2e/app",
    "version": "pnpm run prepare && pnpm run build",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "openapi-typesafe-helpers": "workspace:^"
  },
  "devDependencies": {
    "axios": "1.21.0",
    "express": "5.3.0",
    "feature-fetch": "0.1.2",
    "node-forge": "1.4.3",
    "openapi-typesafe": "workspace:^",
    "openapi-typescript-fetch": "2.2.1",
    "typescript": "catalog:",
    "undici": "7.30.2",
    "vite": "catalog:",
    "vite-node": "6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
