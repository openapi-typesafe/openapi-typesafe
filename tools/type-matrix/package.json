{
  "name": "@openapi-typesafe/type-matrix",
  "version": "0.0.0",
  "private": true,
  "description": "Type-checks generated output and the clients with every supported TypeScript version",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "matrix": "node src/cli/main.ts",
    "lint": "pnpm run lint:js && pnpm run lint:ts",
    "lint:js": "biome check .",
    "lint:ts": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.105.1",
    "@types/react": "19.3.0",
    "openapi-typesafe-fetch": "workspace:*",
    "openapi-typesafe-helpers": "workspace:*",
    "openapi-typesafe-react-query": "workspace:*",
    "react": "19.3.1",
    "typescript": "catalog:",
    "typescript-5.4": "npm:typescript@5.4.5",
    "typescript-5.9": "npm:typescript@5.9.3",
    "typescript-6.0": "npm:typescript@6.0.3",
    "typescript-7.0": "npm:typescript@7.0.2",
    "typescript-7.1-beta": "npm:typescript@7.1.0-beta"
  }
}
