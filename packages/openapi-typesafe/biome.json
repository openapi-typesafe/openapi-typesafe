{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": "//",
  "files": {
    "includes": [
      "bin/**",
      "!examples",
      "src/**",
      "test/**",
      "scripts/bench-printer/**",
      "!**/fixtures/**/*",
      "!test/print-parity/original",
      "!**/dist",
      "!**/coverage"
    ]
  },
  "overrides": [
    {
      "includes": [
        "src/domain/**",
        "src/application/**",
        "src/adapters/**",
        "src/lib/schema-context.ts",
        "src/lib/footer-helpers.ts",
        "test/domain/**",
        "test/application/**",
        "test/adapters/**",
        "test/print-parity/**",
        "test/fakes/**",
        "test/lib/schema-context.test.ts",
        "scripts/bench-printer/**"
      ],
      "formatter": { "lineWidth": 100 }
    }
  ]
}
